# Fastlane Environment Variables Template
# Copy this file to .env and fill in your credentials

# Your Apple ID email address
FASTLANE_APPLE_ID=your.email@example.com

# Application-specific password for App Store Connect
# Generate this at: https://appleid.apple.com/account/manage
# Click "Sign-In and Security" -> "App-Specific Passwords" -> Generate
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your app's bundle identifier
FASTLANE_APP_IDENTIFIER=com.youridentifier.unciv

# Optional: Change log for TestFlight testers
# CHANGELOG="Bug fixes and performance improvements"
